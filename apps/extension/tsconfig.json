{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["chrome", "wxt/browser"]
  },
  "include": [
    "entrypoints/**/*",
    "src/**/*",
    ".wxt/types/*.d.ts"
  ]
}
